<div>
  <div class="flex justify-between items-center">
    <div>
      <h2 class="text-4xl text-gray-800 font-bold"><%= @group.name %></h2>
    </div>
    <%= link_to "＋ イベント作成", "#", class: "text-center bg-blue-500 hover:bg-blue-600 text-white font-semibold p-3 rounded-xl transition" %>
  </div>

  
  <% if @events.present? %>
    <div class="mt-4 space-y-4">
      <% @events.each do |event| %>
        <div class="bg-white rounded-2xl shadow-sm p-5">
          <%= event.title %>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="mt-4 text-gray-400">まだイベントはありません</p>
  <% end %>
</div>
