<div class="min-h-[80vh] flex flex-col">
  <div class="flex justify-between items-center">
    <div>
      <h2 class="text-xl md:text-4xl text-gray-800 font-bold"><%= @group.name %></h2>
    </div>
    <div data-controller="share" data-share-url-value="<%= new_group_join_url(@group.join_token) %>" 
                                 data-share-name-value="<%= @group.name %>"
                                 class="flex flex-col items-end">
      <div>
        <%= link_to "＋ イベント作成", new_group_event_path(@group), class: "btn btn-primary" %>
        <button data-action="click->share#share" class="btn text-gray-800 border border-gray-800 hover:bg-gray-200">共有</button>
      </div>
      <p data-share-target="sharedMessage" class="px-2 rounded-xl"></p>
    </div>
  </div>

  <div class="mt-4 bg-gray-50 flex-grow flex flex-col p-4">
    <% if @events.present? %>
      <div class="mt-4 space-y-4">
        <% @events.each do |event| %>
          <div class="card">
            <%= event.title %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-4 flex-grow flex items-center justify-center text-gray-400">まだイベントはありません</p>
    <% end %>
  </div>
  <%= link_to "グループを削除", group_path(@group), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "mt-4 self-end btn btn-danger" %>
</div>
