<% owned = @group.owned_by?(current_user) %>

<% content_for(:title, @group.name) %>

<div class="grow flex flex-col">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="page-header"><%= @group.name %></h1>
    </div>

    <div
      data-controller="share"
      data-share-url-value="<%= new_group_join_url(@group.join_token) %>"
      data-share-title-value="グループ共有"
      data-share-text-value="グループ「<%= @group.name %>」に参加しませんか？"
      class="flex flex-col items-end shrink-0"
    >
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-action="click->share#share"
          class="p-1.5 rounded-control cursor-pointer hover:bg-sunken"
        >
          <%= render "shared/icons/share", style: "size-6 md:size-8" %>
        </button>

        <% if owned && @events.present? %>
          <%= link_to "＋ イベント作成", new_group_event_path(@group), class: "btn btn-primary" %>
        <% end %>
      </div>

      <p data-share-target="sharedMessage" class="px-2 rounded-control"></p>
    </div>
  </div>

  <div class="index mt-4">
    <% if @events.present? %>
      <div class="mt-4 flex flex-col gap-4">
        <% @events.each do |event| %>
          <%= link_to group_event_path(@group, event) do %>
            <div class="card card-clickable flex flex-col gap-2 w-full">
              <div class="flex justify-between">
                <h2 class="page-lead"><%= event.title %></h2>
                <%= render "shared/event_status_badge", status: event.status %>
              </div>

              <div class="flex gap-4">
                <% if event.location.present? %>
                  <span class="page-caption text-ink-muted">📍<%= event.location %></span>
                <% end %>

                <% if event.confirmed? %>
                  <p class="page-caption text-ink font-bold">
                    <%= l(event.confirmed_candidate_date.date, format: :confirm_card) %>
                  </p>
                  <p class="page-caption">○ <%= @available_counts[event.confirmed_candidate_date_id] %>人</p>
                <% else %>
                  <p class="page-caption">
                    回答 <%= @answered_counts[event.id] %>/<%= @member_count %> 人
                  </p>
                <% end %>
              </div>

              <% unless event.confirmed? %>
                <% percent = @answered_counts[event.id]*100/@member_count %>
                <div class="bg-sunken w-full h-2 rounded-full">
                  <div class="bg-brand rounded-full h-2" style="width: <%= percent %>%"></div>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <% if owned %>
          <p>まだイベントはありません。イベントを作成してみましょう！</p>
          <%= link_to "＋ イベント作成", new_group_event_path(@group), class: "btn btn-primary" %>
        <% else %>
          <p>まだイベントはありません。</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if owned %>
    <%= link_to "グループを削除", group_path(@group), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "mt-4 self-end btn btn-danger" %>
  <% end %>
</div>
