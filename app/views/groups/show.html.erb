<% owned = @group.owned_by?(current_user) %>

<div class="grow flex flex-col">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="page-header"><%= @group.name %></h1>
    </div>

    <div
      data-controller="share"
      data-share-url-value="<%= new_group_join_url(@group.join_token) %>"
      data-share-title-value="グループ共有"
      data-share-text-value="グループ「<%= @group.name %>」に参加しませんか？"
      class="flex flex-col items-end"
    >
      <div>
        <% if owned && @events.present? %>
          <%= link_to "＋ イベント作成", new_group_event_path(@group), class: "btn btn-primary" %>
        <% end %>

        <button
          data-action="click->share#share"
          class="btn text-gray-800 border border-gray-800 hover:bg-gray-200"
        >
          共有
        </button>
      </div>

      <p data-share-target="sharedMessage" class="px-2 rounded-xl"></p>
    </div>
  </div>

  <div class="index mt-4">
    <% if @events.present? %>
      <div class="mt-4 flex flex-col gap-4">
        <% @events.each do |event| %>
          <%= link_to group_event_path(@group, event) do %>
            <div class="card card-clickable">
              <%= event.title %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <% if owned %>
          <p>まだイベントはありません。イベントを作成してみましょう！</p>
          <%= link_to "＋ イベント作成", new_group_event_path(@group), class: "btn btn-primary" %>
        <% else %>
          <p>まだイベントはありません。</p>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if owned %>
    <%= link_to "グループを削除", group_path(@group), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "mt-4 self-end btn btn-danger" %>
  <% end %>
</div>
