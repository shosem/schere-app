<div class="grow flex flex-col justify-center">
  <div class="text-center">
    <h1 class="page-header"><%= t('.create') %></h1>
    <p class="page-caption">グループ名を設定しましょう！招待リンクはグループ作成後に共有できます。</p>
  </div>
  <%= form_with model: @group, class: "w-full max-w-3xl mx-auto" do |f|  %>
    <div>
      <%= f.label :name,  class: "form-label" %>
      <%= f.text_field :name, class: "form-input" %>
    </div>
    <%= f.submit t('.submit'), class: "mt-4 w-full btn btn-primary py-2" %>
  <% end %>
</div>


