<% content_for(:title, "グループ一覧") %>

<div class="grow flex flex-col">
  <div class="flex justify-between items-center">
    <h1 class="page-header">グループ一覧</h1>

    <%# @groupsが空の場合は重複しないように右上のボタンを隠す %>
    <% if @groups.present? %>
      <%= link_to "＋ グループ作成", new_group_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <div class="index mt-4">
    <% if @groups.present? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @groups.each do |group| %>
          <%= link_to group_path(group) do %>
            <div class="card card-clickable flex flex-col h-full">
              <h2 class="page-lead"><%= group.name %></h2>

              <p class="page-caption mt-auto">
                <%= group.events.size %>件のイベント |
                <%= group.guests.size + 1 %>人が参加中
              </p>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <p>まだグループはありません。グループを作成してみましょう！</p>
        <%= link_to "＋ グループ作成", new_group_path, class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
