<div>
  <div class="flex justify-between items-center">
    <h2 class="text-xl md:text-4xl text-gray-800 font-bold">こんにちは、<%= current_user.name %>さん！</h2>
    <%= link_to "＋ グループ作成", new_group_path, class: "btn btn-primary" %>
  </div>
  <p class="text-sm text-gray-400">予定を管理しましょう！</p>

  <% if @groups.present? %>

    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @groups.each do |group| %>
        <%= link_to group_path(group) do %>
          <div class="card">
            <%= group.name %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p>まだグループはありません</p>
  <% end %>
</div>
