<div class="card bg-ok-subtle flex flex-col mt-4 min-h-40" data-testid="confirmed-date">

  <div class="flex justify-between items-center">
   <h2 class="page-section text-ok">確定日程</h2>
   <%= link_to "調整中に戻す", group_event_confirmation_path(group, event), data: { turbo_method: :delete, turbo_confirm: "調整中に戻しますか？" }, 
     class: "btn text-ok border border-ok bg-ok-subtle hover:bg-ok hover:text-ok-subtle" %>
  </div>

  <div class="flex justify-center items-center gap-4">
    <p class="page-header text-ink"><%= l(event.confirmed_candidate_date.date, format: :long) %></p>
    <div class="flex items-center">
      <%= render "times", c: event.confirmed_candidate_date, color: "text-ink", size: "page-header" %>
    </div>
  </div>
</div>

<%# 施設情報のセクション %>

<% unless current_guest && event.venues.empty? %>
  <div class="card card-sunken flex flex-col mt-4">
    <div class="flex justify-between items-center">
      <h2 class="page-section">施設情報</h2>
      <% if group.owned_by?(current_user) %>
        <%= link_to "＋追加", new_group_event_venue_path(group, event), data: { turbo_frame: "modal" }, class: "btn btn-primary py-1.5" %>
      <% end %>
    </div>

    <%# 施設情報リスト %>
    <div id="venues-list">
      <% if event.venues.present? %>
        <%= render event.venues %>
      <% end %>
    </div>
  </div>
<% end %>


<div class="card card-sunken flex flex-col mt-4 gap-2">
  <h2 class="page-section">集計結果</h2>
  <div class="flex justify-center gap-4">
    <div class="card h-40 bg-brand-subtle border-brand flex flex-1 flex-col items-center justify-center" data-testid="available">
      <p class="page-count text-brand"><%= vote_counts[event.confirmed_candidate_date_id]["available"] %></p>
      <p class="page-count text-brand">○</p>
    </div>

    <div class="card h-40 bg-warn-subtle border-warn flex flex-1 flex-col items-center justify-center">
      <p class="page-count text-warn"><%= vote_counts[event.confirmed_candidate_date_id]["maybe"] %></p>
      <p class="page-count text-warn">△</p>
    </div>

    <div class="card h-40 bg-danger-subtle border-danger flex flex-1 flex-col items-center justify-center">
      <p class="page-count text-danger"><%= vote_counts[event.confirmed_candidate_date_id]["unavailable"] %></p>
      <p class="page-count text-danger">×</p>
    </div>
  </div>
  <%= render "voter_names", names: voter_names[event.confirmed_candidate_date_id] %>
</div>
