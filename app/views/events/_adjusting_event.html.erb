<div class="card card-sunken flex flex-col mt-4" data-testid="answer-status">
  <h2 class="page-section">日程を投票する</h2>

  <%= form_with url: group_event_vote_path(group, event), class: "flex flex-col gap-4 mt-4" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
      <% candidate_dates.each do |c| %>
        <%# 候補日ごとのカード %>
        <div class="card card-surface p-4">
          <div class="page-lead text-ink-strong font-bold">
            <%= l(c.date, format: :long) %>
          </div>

          <%# 候補日ごとの時間 %>
          <div class="flex justify-start mb-2">
            <%= render "times", c: c %>
          </div>

          <div class="flex justify-between items-center">
            <div class="flex items-center gap-3">
              <label>
                <%= radio_button_tag "votes[#{c.id}]", :available, my_votes[c.id] == "available", class: "sr-only peer" %>

                <span class="vote-btn vote-available"> ○ </span>
              </label>

              <label>
                <%= radio_button_tag "votes[#{c.id}]", :maybe, my_votes[c.id] == "maybe", class: "sr-only peer" %>

                <span class="vote-btn vote-maybe"> △ </span>
              </label>

              <label>
                <%= radio_button_tag "votes[#{c.id}]", :unavailable, my_votes[c.id] == "unavailable", class: "sr-only peer" %>

                <span class="vote-btn vote-unavailable"> × </span>
              </label>
            </div>

            <%# 候補日ごとの投票数 %>
            <div class="flex flex-col items-center gap-2">
              <%= render "vote_counts", counts: vote_counts[c.id], id: c.id %>

              <div class="text-ink-muted text-caption">
                回答済み：<%= c.votes.size %>人
              </div>
            </div>
          </div>

          <div class="mt-2">
            <%= render "voter_names", names: voter_names[c.id] %>
          </div>
        </div>
      <% end %>
    </div>

    <%= f.submit "送信する", class: "btn btn-primary" %>
  <% end %>
</div>

<%# 日程確定のセクション。閲覧者 = 管理者の場合のみ表示 %>
<% if group.owned_by?(current_user) %>
  <div class="card card-sunken mt-4" data-testid="confirm-section">
    <h2 class="page-section">日程を確定する</h2>

    <%# 日程ごとのカード %>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
      <% candidate_dates.each do |c| %>
        <%= button_to group_event_confirmation_path(group, event), 
                                method: :patch, 
                                data: { turbo_confirm: "日程を確定しますか？", testid: "confirm-#{c.id}" },
                                params: { candidate_date_id: c.id },
                                class: "card card-clickable w-full p-2 md:p-4 h-36 relative" do %>
          <div dir="rtl">
            <p class="page-lead text-center">
              <%= l(c.date, format: :confirm_card) %>
            </p>

            <div class="absolute inset-s-1 top-1 flex items-center gap-1">
              <% if top_available_day_ids.include?(c.id) %>
                <span class="badge text-brand border bg-brand-subtle p-1">
                  人気
                </span>
              <% end %>

              <% if fewest_unavailable_day_ids.include?(c.id) %>
                <span class="badge text-ok border bg-ok-subtle p-1">
                  反対少なめ
                </span>
              <% end %>
            </div>
          </div>

          <%# 時間の入力があれば表示 %>
          <div class="flex justify-center">
            <%= render "times", c: c %>
          </div>

          <%# 投票数を表示する %>
          <div class="flex items-center justify-center text-lead gap-2">
            <%= render "vote_counts", counts: vote_counts[c.id], id: c.id %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
