<details>
  <summary class="text-gray-500 cursor-pointer">回答者を見る</summary>
  
  <div class="flex gap-2 items-center">
    <span class="text-blue-500">○</span>
    <%= names["available"].present? ? names["available"].join("、") : "-" %>
  </div>
  <div class="flex gap-2 items-center">
    <span class="text-amber-500">△</span>
    <%= names["maybe"].present? ? names["maybe"].join("、") : "-" %>
  </div>
  <div class="flex gap-2 items-center">
    <span class="text-red-500">×</span>
    <%= names["unavailable"].present? ? names["unavailable"].join("、") : "-" %>
  </div>
</details>