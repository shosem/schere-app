<div class="min-h-[80vh] flex flex-col">
  <div>
    <h2 class="text-4xl text-gray-800 font-bold"><%= t('.create') %></h2>
    <p class="mt-2 text-sm text-gray-400">イベントを作成しましょう！楽しみだね~~</p>
  </div>
  <div class="flex-grow flex flex-col justify-center">
    <div class="w-full max-w-3xl mx-auto card">
      <%= form_with model: [ @group, @event ] do |f| %>
        <%= render "shared/error_messages", resource: @event %>
       <div class="mt-4">
          <%= f.label :title,  class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :title, class: "w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

        <div class="mt-4">
          <%= f.label :location,  class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :location, class: "w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

        <div class="mt-4">
          <%= f.label :description,  class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_area :description, rows: 8,  class: "w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

        <% # 候補日の追加UI %>

          <div data-controller="calendar" class="mt-4 w-full bg-gray-200 flex flex-col items-center">
            <p>候補日の追加</p>

            <div class="flex justify-between">
              <% # カレンダー操作ボタン %>
              <button type="button" data-action='click->calendar#prevMonth'>＜</button>
              <span data-calendar-target="monthLabel"></span>
              <button type="button" data-action='click->calendar#nextMonth'>＞</button>
            </div>

            <div data-calendar-target="grid">
              <% # カレンダー %>
            </div>

            <small>日付をタップして選択</small>

            <p>選択済みの日程</p>
            <div>
              <input type="time" min="00:00" max="23:59">
              <input type="time" min="00:00" max="23:59">
            </div>

            <div data-calendar-target="selectedList">
              <% # 選択済みの日程を追加するリスト %>
            </div>

            <div data-calendar-target="hiddenContainer">
              <% # 隠しフィールド。ここからデータを送信する %>
            </div>
            
          </div>



      
        <%= f.submit t('.submit'), class: "mt-4 w-full btn btn-primary py-2" %>
      <% end %>
    </div>
  </div>
</div>
