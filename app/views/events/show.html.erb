<% badge = {
             "adjusting"  => ["調整中",   "badge-pending"],
             "confirmed"  => ["確定済み", "badge-done"]
            } %>

<%# タイトル、場所、説明表示div %>
<div>
  <div
    class="flex justify-between items-center"
    data-controller="share"
    data-share-url-value="<%= new_group_join_url(@group.join_token, event_id: @event.id) %>"
    data-share-title-value="イベント共有"
    data-share-text-value="イベント「<%= @event.title %>」に参加しませんか？"
  >
    <div class="flex flex-col items-start">
      <div class="flex flex-col items-center justify-center">
        <span class="badge <%= badge[@event.status][1] %>"><%= badge[@event.status][0] %></span>
      </div>

      <h1 class="page-header"><%= @event.title %></h1>
    </div>

    <div class="flex flex-col">
      <div class="flex gap-2 items-center">
        <button
          data-action="click->share#share"
          class="btn btn-secondary py-1.5"
        >
          共有
        </button>

        <% if @group.owned_by?(current_user) %>
          <%= link_to "編集", edit_group_event_path(@group, @event), class: "btn btn-secondary py-1.5" %>
          <%= link_to "削除", group_event_path(@group, @event), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-danger py-1.5" %>
        <% end %>
      </div>

      <p data-share-target="sharedMessage" class="px-2 rounded-control"></p>
    </div>
  </div>

  <% if @event.location.present? %>
    <span class="text-caption text-ink-muted font-bold">📍<%= @event.location %></span>
  <% end %>

  <% if @event.description.present? %>
    <div class="card card-sunken mt-2 flex flex-col gap-2">
      <p class="page-lead text-ink-muted">説明</p>

      <p class="whitespace-pre-line text-body text-ink leading-relaxed"><%= @event.description %></p>
    </div>
  <% end %>
</div>

<% if @event.adjusting? %>
  <%= render "adjusting_event",
              group: @group,
              event: @event,
              vote_counts: @vote_counts,
              voter_names: @voter_names,
              candidate_dates: @candidate_dates,
              top_available_day_ids: @top_available_day_ids,
              fewest_unavailable_day_ids: @fewest_unavailable_day_ids,
              my_votes: @my_votes %>
<% elsif @event.confirmed? %>
  <%= render "confirmed_event",
              group: @group,
              event: @event,
              vote_counts: @vote_counts,
              voter_names: @voter_names %>
<% end %>

<%= link_to "←グループに戻る", group_path(@group), class: "mt-2 w-fit text-ink-muted transition hover:text-ink-strong hover:border-b border-ink-muted" %>
