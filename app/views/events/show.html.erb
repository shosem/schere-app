<% badge = {
             "adjusting"  => ["調整中",   "bg-amber-100 text-amber-700"],
             "confirmed"  => ["確定済み", "bg-green-100 text-green-700"],
             "cancelled"  => ["キャンセル", "bg-gray-100 text-gray-500"]
            } %>

<div class="mb-4">
  <span class="text-xs font-bold px-2.5 py-1 rounded-full <%= badge[@event.status][1] %>"><%= badge[@event.status][0] %></span>

  <% # タイトル、場所、説明表示div %>
  <div>
    <h1 class="text-4xl text-gray-800 font-bold mt-4"><%= @event.title %></h1>
    <% if @event.location.present? %>
      <span class="text-sm text-gray-400">📍<%= @event.location %></span>
    <% end %>
    <% if @event.description.present? %>
      <div class="bg-gray-50 rounded-2xl px-5 py-4 mt-3">
        <p class="text-xs font-bold text-gray-400 mb-2">説明</p>
        <p class="whitespace-pre-line text-sm text-gray-600 leading-relaxed"><%= @event.description %></p>
      </div>
    <% end %>
   </div>

  <% # 候補日の投票フォーム全体 %>
  <% if @event.adjusting? %>
    <div class="card flex flex-col mt-4" data-testid="answer-status">
    
      <h2 class="text-xl text-gray-800 font-bold">回答状況</h2>
      <%= form_with url: group_event_vote_path(@group, @event), class: "flex flex-col gap-4 mt-4" do |f| %>
        <% @candidate_dates.each do |c| %>

          <% # 候補日ごとのカード %>
          <div class="flex flex-col card p-4">
            <div class="text-xl text-gray-800 font-bold">
              <%= l(c.date, format: :long) %>
            </div>
            
            <% # 候補日ごとの時間 %>
            <div class="flex justify-start mb-2">
              <%= render "times", c: c %>
            </div>

            <div class="flex justify-between items-center">
              <div class="flex items-center gap-3">
                <label>
                  <%= radio_button_tag "votes[#{c.id}]", :available, @my_votes[c.id] == "available", class: "sr-only peer" %>
                  <span class="peer-checked:text-blue-500 peer-checked:border-blue-500 peer-checked:bg-blue-50
                               text-gray-400 text-lg font-bold border-2 border-gray-200 rounded-full flex items-center justify-center w-11 h-11 hover:border-blue-300">○</span>
               </label>
                <label>
                  <%= radio_button_tag "votes[#{c.id}]", :maybe, @my_votes[c.id] == "maybe", class: "sr-only peer" %>
                  <span class="peer-checked:text-amber-500 peer-checked:border-amber-500 peer-checked:bg-amber-50
                               text-gray-400 text-lg font-bold border-2 border-gray-200 rounded-full flex items-center justify-center w-11 h-11 hover:border-amber-300">△</span>
                </label>
                <label>
                  <%= radio_button_tag "votes[#{c.id}]", :unavailable, @my_votes[c.id] == "unavailable", class: "sr-only peer" %>
                  <span class="peer-checked:text-red-500 peer-checked:border-red-500 peer-checked:bg-red-50
                               text-gray-400 text-lg font-bold border-2 border-gray-200 rounded-full flex items-center justify-center w-11 h-11 hover:border-red-300">×</span>
                </label>
              </div>

              <% # 候補日ごとの投票数 %>
              <div class="flex items-center gap-2">
                <%= render "vote_counts", counts: @vote_counts[c.id], id: c.id %>
                <div class="text-gray-400 text-sm">
                  回答済み：<%= c.votes.size %>人
                </div>
              </div>
            </div>
            <div class="mt-2">
              <%= render "voter_names", names: @voter_names[c.id] %>
            </div>
          </div>
        <% end %>
        <%= f.submit "送信する", class: "btn btn-primary" %>
      <% end %>
    </div>

    <% # 日程確定のセクション。閲覧者 = 管理者の場合のみ表示 %>
    <% if current_user && current_user.id == @group.user_id %>
      <div class="card mt-4" data-testid="confirm-section">
        <h2 class="text-xl text-gray-800 font-bold">日程を確定する</h2>

        <% # 日程ごとのカード %>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-4">
          <% @candidate_dates.each do |c| %>
           <%= button_to group_event_confirmation_path(@group, @event), 
                                    method: :patch, 
                                    data: { turbo_confirm: "日程を確定しますか？" },
                                    params: { candidate_date_id: c.id },
                                    class: "card w-full p-2 md:p-4 shadow-md cursor-pointer bg-gray-100/50 hover:bg-gray-200" do %>
              <div class="relative">                                    
                <p class="text-xl text-gray-700 font-bold text-center"><%= l(c.date, format: :confirm_card) %></p>
                <div class="absolute inset-y-0 right-0 flex items-center gap-1">
                  <% if @top_available_day_ids.include?(c.id) %>
                    <span class="text-[10px] md:text-xs font-bold text-blue-700 border rounded-full bg-blue-100 p-1">人気！</span>
                  <% end %>
                  <% if @fewest_unavailable_day_ids.include?(c.id) %>
                    <span class="text-[10px] md:text-xs font-bold text-green-700 border rounded-full bg-green-100 p-1">反対少なめ！</span>
                  <% end %>
                </div>
              </div>             
              <% # 時間の入力があれば表示 %>
              <div class="flex justify-center">
                <%= render "times", c: c %>
              </div>
              <% # 投票数を表示する %>
              <div class="flex items-center justify-center text-xl gap-2">
                <%= render "vote_counts", counts: @vote_counts[c.id], id: c.id  %>
              </div>
            <% end%>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

<%= link_to "←グループに戻る", group_path(@group), class: "inline-flex items-center text-gray-500 bg-gray-50 rounded-full p-2 transition hover:bg-gray-100 hover:outline hover:text-gray-700" %>