<%# ゲストログイン時はフッターナビを出さない。ヘッダーのグループ名リンクが担う %>
<% if user_signed_in? %>
  <div class="h-20 md:hidden"></div>
  <nav class="md:hidden fixed bottom-0 inset-x-0 h-20 bg-white border-t border-gray-200 py-4" aria-label="モバイルナビ">
    <div class="grid grid-cols-3 max-w-full mx-auto">
      <%# ダッシュボード %>
      <%= link_to root_path, class: "flex flex-col justify-center items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        <p class="text-sm text-gray-400 text-center"><%= t('.dashboard') %></p>
      <% end %>
      <%# イベント作成＋ %>
      <%= link_to new_event_group_selection_path, "aria-label": "イベント作成", data: { turbo_frame: "modal" }, class: "w-14 h-14 -mt-1 rounded-full bg-blue-500 text-white shadow-lg flex items-center justify-center justify-self-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-6 text-white">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
      <% end %>
      <%# 設定 %>
      <%= link_to edit_user_registration_path, class: "flex flex-col justify-center items-center" do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
        </svg>
        <p class="text-sm text-gray-400 text-center"><%= t('.edit') %></p>
      <% end %>
    </div>
  </nav>
<% end %>

<footer class="hidden md:block border-t border-gray-200 py-6 text-center text-sm text-gray-400">
  © 2026 Schere
</footer>
