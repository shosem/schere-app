<header class="sticky top-0 z-50 bg-ground border-b border-line">
  <div
    class="
      max-w-full mx-auto px-4 md:px-6 flex items-center relative
      justify-between h-16
    "
  >
    <%# ロゴ（共通） %>
    <%= header_logo %>

    <% if user_signed_in? %>
      <%# ログイン時 %>
      <div
        data-controller="dropdown"
        data-action="click@window->dropdown#hide"
        class="flex items-center gap-3"
      >
        <button
          type="button"
          data-action="click->dropdown#toggle"
          class="
            w-9 h-9 rounded-full bg-brand-subtle text-brand hover:border hover:cursor-pointer border-brand flex items-center
            justify-center text-caption font-bold
          "
        >
          <%= current_user.name.first %>
        </button>

        <div
          data-dropdown-target="menu"
          class="
            absolute hidden top-full right-0 w-fit card card-surface
            shadow-lg p-1
          "
        >
          <%= link_to "グループ作成", new_group_path, class: "dropdown" %>
          <%= link_to "アカウント設定", edit_user_registration_path, class: "dropdown" %>

          <%= button_to "ログアウト", destroy_user_session_path, method: :delete,                                                                                                            
                class: "dropdown w-full text-start text-danger" %>

          <hr class="my-2 border-line">
          <%= link_to "利用規約", terms_path, class: "dropdown" %>
          <%= link_to "プライバシーポリシー", privacy_path, class: "dropdown" %>
          <%= link_to "お問い合わせ", contact_path, class: "dropdown" %>
        </div>
      </div>
    <% elsif current_guest %>
      <%# ゲスト入室時 %>
      <%= link_to truncate(current_guest.group.name, length: 10), group_path(current_guest.group),
                    class: "btn bg-brand-subtle text-brand absolute left-1/2 -translate-x-1/2" %>
      <div
        data-controller="dropdown"
        data-action="click@window->dropdown#hide"
        class="flex items-center gap-3"
      >
        <button
          type="button"
          data-action="click->dropdown#toggle"
          class="cursor-pointer"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
            />
          </svg>
        </button>

        <div
          data-dropdown-target="menu"
          class="
            absolute hidden top-full right-0 w-fit card card-surface
            shadow-lg p-1
          "
        >
          <p
            class="
              text-center px-2 md:px-4 py-1 md:py-2 text-badge
              md:text-caption text-ink
            "
          >
            <%= current_guest.name %>
          </p>

          <hr class="border-line">
          <%= link_to "ユーザー登録", new_user_registration_path, class: "dropdown" %>
          <%= link_to "ログイン", new_user_session_path, class: "dropdown" %>

          <%= button_to "退室する", destroy_guest_session_path, method: :delete,
                  class: "dropdown text-danger" %>

          <hr class="my-2 border-line">
          <%= link_to "利用規約", terms_path, class: "dropdown" %>
          <%= link_to "プライバシーポリシー", privacy_path, class: "dropdown" %>
          <%= link_to "お問い合わせ", contact_path, class: "dropdown" %>
        </div>
      </div>
    <% else %>
      <%# 非ログイン時 %>
      <nav class="flex items-center gap-4">
        <%= link_to "ログイン", new_user_session_path,                                                                                                                                     
              class: "text-badge md:text-caption font-medium text-ink hover:text-ink-strong hover:border-b" %>

        <%= link_to "新規登録", new_user_registration_path,                                                                                                                                
              class: "btn btn-primary text-badge md:text-caption p-2" %>
      </nav>
    <% end %>
  </div>
</header>
