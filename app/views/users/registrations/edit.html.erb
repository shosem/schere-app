<div class="min-h-screen flex">
  <div class="hidden md:w-1/2 md:bg-blue-500 md:flex md:flex-col md:items-center md:justify-center md:text-white md:p-12">
    <h1 class="text-4xl font-bold mb-4">Schere</h1>
    <p class="text-lg">このアプリは予定を共有するアプリ</p>
  </div>

  <div class="w-full md:w-1/2 flex items-center justify-center bg-white p-6 md:p-12">
    <div class="w-full max-w-sm">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">アカウント情報の変更</h2>
      
      <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>

        <div class="mb-4">
          <p><%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %></p>
          <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %></p>
        </div>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
        <% end %>

        <div class="mb-4">
          <p><%= f.label :password, class: "block text-sm font-medium text-gray-700" %></p>
          <p class="text-sm mb-1">(変更したくない場合は空白にしてください)</p>
          <p><%= f.password_field :password, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %></p>
          <% if @minimum_password_length %>
            <p class="text-sm text-red-500">※<%= @minimum_password_length %>文字以上</p>
          <% end %>
        </div>

        <div class="mb-4">
          <p><%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %></p>
          <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %></p>
        </div>

        <div class="mb-4">
          <p><%= f.label :current_password, class: "block text-sm font-medium text-gray-700 mb-1" %></p>
          <p><%= f.password_field :current_password, autocomplete: "current-password", class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %></p>
        </div>

        <%= f.submit t("devise.registrations.edit.update"), class: "w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 font-medium" %>
      <% end %>

      <div class="my-6 flex items-center">
        <div class="flex-grow border-t border-gray-200"></div>
      </div>

       <%= button_to t("devise.registrations.edit.cancel_my_account"), registration_path(resource_name), data: { confirm: t("devise.registrations.edit.are_you_sure"), turbo_confirm: t("devise.registrations.edit.are_you_sure") }, method: :delete, class: "w-full bg-red-500 text-white rounded-lg border border-transparent hover:bg-white hover:text-red-500 hover:border hover:border-red-500" %>

       <%= link_to "戻る", :back, class: "block w-full mt-4 text-center bg-gray-200 text-black rounded-lg hover:bg- hover:bg-gray-300" %>
