<div class="min-h-screen flex">
  <% # 左のロゴ %>
  <div class="hidden md:w-1/2 md:bg-blue-500 md:flex md:flex-col md:items-center md:justify-center md:text-white md:p-12">
    <h1 class="text-4xl font-bold mb-4">Schere</h1>
    <p class="text-lg">このアプリは予定を共有するアプリ</p>
  </div>

  <% # 右のフォーム %>
  <div class="w-full md:w-1/2 flex items-center justify-center bg-white p-6 md:p-12">
    <div class="w-full max-w-sm">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">アカウント登録</h2>

      <%= form_with(model: resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "users/shared/error_messages", resource: resource %>

        <div class="mb-4">
          <%= f.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.text_field :name, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

        <div class="mb-4">
          <%= f.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.email_field :email, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

         <div class="mb-4">
          <%= f.label :password, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

        <div class="mb-4">
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" %>
        </div>

        <%= f.submit '保存する', class: "w-full bg-blue-500 text-white py-2 rounded-lg hover:bg-blue-600 font-medium" %>
      <% end %>
    </div>
  </div>
</div>