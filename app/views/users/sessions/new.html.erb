<div class="min-h-screen flex">
  <div
    class="
      hidden md:w-1/2 md:bg-brand md:flex md:flex-col md:items-center
      md:justify-center md:text-white md:p-12
    "
  >
    <h1 class="page-header text-white mb-4">Schere</h1>
    <p class="text-lead">予定を共有しましょう！</p>
  </div>

  <div class="w-full md:w-1/2 flex items-center justify-center bg-white p-6 md:p-12">
    <div class="w-full max-w-sm flex flex-col">
      <h2 class="text-center page-lead mb-4">ログイン</h2>

      <%= form_with(model: resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="field">
          <p><%= f.label :email, class: "form-label" %></p>

          <p>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input" %>
          </p>
        </div>

        <div class="field">
          <p><%= f.label :password, class: "form-label" %></p>

          <p>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-input" %>
          </p>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="field">
            <p>
              <%= f.check_box :remember_me %><span class="ml-2"><%= f.label :remember_me %></span>
            </p>
          </div>
        <% end %>

        <%= f.submit "ログイン", class: "mt-4 w-full btn btn-primary font-medium" %>
      <% end %>

      <div class="my-6 flex items-center">
        <div class="grow border-t border-line"></div>
        <span class="mx-3 text-caption text-ink-muted">または</span>
        <div class="grow border-t border-line"></div>
      </div>

      <%= link_to "アカウントを作る！", new_user_registration_path,
           class: "btn btn-secondary" %>
    </div>
  </div>
</div>
